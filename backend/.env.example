# 复制此文件为 backend/.env 并填入你自己的密钥。
# 通义千问 ASR（DashScope 百炼）API Key；文化导师也会默认复用该 Key。
DASHSCOPE_API_KEY=d'd
# ASR 模型名（默认即可）。
QWEN_ASR_MODEL=qwen-audio-3.0-asr-flash

# 可选：单独为文化导师配置聊天模型。未配置时会使用 DASHSCOPE_API_KEY；
# 若两者都未配置，则自动使用本地知识卡回答。
CULTURE_LLM_API_KEY=
CULTURE_LLM_MODEL=qwen-plus
# CULTURE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
